# ======= Environment Configuration =======
# Used only when running locally against CDP environments (AWS VPN required).

# Set to true when running Playwright locally (not CI, not from inside CDP)
# against a CDP environment. Backend services aren't reachable from outside
# CDP's network via their direct URL, so this switches to the protected
# ephemeral gateway instead.
CDP_LOCAL=

# Set to one of: dev, test, perf-test, ext-test
PLAYWRIGHT_ENVIRONMENT=

# Required when CDP_LOCAL=true. Sent as x-api-key on every request to a
# service reached via the ephemeral gateway. See the Developer API key docs.
DEVELOPER_API_KEY=

# ======= Zed Attack Proxy (ZAP) =======
# Optional override; defaults to 9095 for local/compose stub ZAP.
ZAP_PORT=

# Optional override; defaults to local-dev-key for local/compose stub ZAP.
ZAP_API_KEY=

# ======= BrowserStack =======
BROWSERSTACK_USER=martynnevers_q7DeWu

# ======= CDP Secrets =======
# Optional override; defaults to Password123 for local/compose stub sign-in.
AUTH_PASSWORD=

# BrowserStack access key for remote browser runs.
BROWSERSTACK_KEY=
